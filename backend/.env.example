# PostgreSQL Database Connection URL (e.g. postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/burdenoff_db?schema=public"

# JWT Secret Key for signing and verifying tokens (generate a strong random 32+ character string in production)
JWT_SECRET="your-secure-random-jwt-secret-key-at-least-32-chars-long"

# Business Timezone for SLA calculations (IANA timezone identifier, default: Asia/Kolkata)
BUSINESS_TIMEZONE="Asia/Kolkata"

# Allowed CORS Origins (use * in development or comma-separated list of allowed URLs e.g. https://your-app.vercel.app)
CORS_ORIGIN="*"

# Runtime Environment (development | production | test)
NODE_ENV="development"

# HTTP Port (local: 4000, Render default: 10000)
PORT=4000

