# PostgreSQL Database Connection URL (provided automatically by Render or localhost in Docker)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/burdenoff_db?schema=public"

# JWT Secret Key for signing and verifying tokens
JWT_SECRET="super-secret-jwt-key-burdenoff-support-tracker-2026"

# Business Timezone for SLA calculations (default: Asia/Kolkata)
BUSINESS_TIMEZONE="Asia/Kolkata"

# Allowed CORS Origins (use * or comma-separated Vercel frontend URLs)
CORS_ORIGIN="*"

# Runtime Environment
NODE_ENV="production"

# Port (default on Render is 10000, local is 4000)
PORT=4000
